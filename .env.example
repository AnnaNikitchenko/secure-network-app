# Copy to .env and replace the JWT signing secret with 32+ random bytes.
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
JWT_TTL_SECONDS=900
APP_DB=data/users.sqlite3
APP_LOG=logs/server.jsonl
SERVER_HOST=0.0.0.0
SERVER_PORT=8443
TLS_CERT=data/server.crt
TLS_KEY=data/server.key
TLS_CA=data/ca.crt
TLS_SERVER_NAME=localhost
CLIENT_HOST=127.0.0.1
CLIENT_PORT=8443
LOCK_ATTEMPTS=5
LOCK_SECONDS=300
# Add the server's static/private VMware IP when generating its TLS certificate.
CERT_IP=
